{
  "name": "markingman/fields",
  "description": "Lightweight, type-safe PHP form-fields handler",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "MarkIngman\\Fields\\": [
        "src"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MarkIngman\\Fields\\": [
        "tests/fixtures",
        "tests/integration",
        "tests/unit"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "~12.5",
    "phpstan/phpstan": "~2.1.22",
    "ext-curl": "*"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
