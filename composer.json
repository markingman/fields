{
  "name": "markingman/fields",
  "description": "PHP form fields handler.",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "MarkIngman\\Fields\\": [
        "src/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MarkIngman\\Fields\\": [
        "tests/unit/",
        "tests/fixtures/"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "~12.3.4",
    "phpstan/phpstan": "~2.1.22"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
